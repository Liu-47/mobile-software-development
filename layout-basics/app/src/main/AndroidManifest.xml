<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:hardwareAccelerated="false"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Layoutbasics">

        <!-- 任务1：线性布局（整屏黑底格子，无标题栏） -->
        <activity
            android:name=".LinearLayoutActivity"
            android:exported="true"
            android:label="@string/linear_title"
            android:theme="@style/Theme.Layoutbasics.NoActionBar" />

        <!-- 任务2：表格布局 -->
        <activity
            android:name=".TableLayoutActivity"
            android:exported="true"
            android:label="@string/table_title" />

        <!-- 任务3：约束布局 · 计算器 -->
        <activity
            android:name=".CalculatorActivity"
            android:exported="true"
            android:label="@string/calc_title" />

        <!-- 任务4：约束布局 · 火星预订页（自绘顶部标签栏，无标题栏） -->
        <activity
            android:name=".MarsActivity"
            android:exported="true"
            android:label="@string/mars_title"
            android:theme="@style/Theme.Layoutbasics.NoActionBar" />
    </application>

</manifest>
