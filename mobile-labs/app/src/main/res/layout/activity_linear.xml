<?xml version="1.0" encoding="utf-8"?>
<!--
    任务1：线性布局（LinearLayout）
    外层竖直 LinearLayout 均分 4 行，每行是水平 LinearLayout；
    每行 4 个格子用 layout_weight 分配宽度：第 2 列 weight=2，明显比其他列宽。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 第 1 行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:text="@string/cell_1_1"
            android:textColor="@color/cell_text"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="2"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:text="@string/cell_1_2"
            android:textColor="@color/cell_text"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:text="@string/cell_1_3"
            android:textColor="@color/cell_text"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:text="@string/cell_1_4"
            android:textColor="@color/cell_text"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- 第 2 行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:text="@string/cell_2_1"
            android:textColor="@color/cell_text"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="2"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:text="@string/cell_2_2"
            android:textColor="@color/cell_text"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:text="@string/cell_2_3"
            android:textColor="@color/cell_text"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:text="@string/cell_2_4"
            android:textColor="@color/cell_text"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- 第 3 行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:text="@string/cell_3_1"
            android:textColor="@color/cell_text"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="2"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:text="@string/cell_3_2"
            android:textColor="@color/cell_text"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:text="@string/cell_3_3"
            android:textColor="@color/cell_text"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:text="@string/cell_3_4"
            android:textColor="@color/cell_text"
            android:textSize="20sp" />
    </LinearLayout>

